{
  "Data": {
    "MimosiGeDatabase": {
      "ConnectionString": "DatabaseConnectionString"
    }
  },

  "IdentitySettings": {
    "JwtSecret": "JwtSecret",
    "JwtIssuer": "JwtIssuer",
    "JwtAudience": "JwtAudience",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "FrontendBaseUrl": "FrontendBaseUrl"
  },

  "EmailSettings": {
    "SmtpServer": "SmtpServer",
    "SmtpPort": 587,
    "SmtpUsername": "SmtpUsername",
    "SmtpPassword": "SmtpPassword",
    "SenderEmailAddress": "SenderEmailAddress",
    "SenderName": "SenderName"
  },

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5070"
      }
    }
  },

  "Logging": {
    "File": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Console": {
      "IncludeScopes": true
    }
  },

  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "PathToLogFile",
          "rollingInterval": "Day"
        }
      }
    ]
  },

  "CorsSettings": {
    "Origins": []
  },

  "VersionInfo": {
    "AppSettingsVersion": "1.1"
  },

  "MediatRLicenseKey": ""
}