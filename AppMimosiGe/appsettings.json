{
  "Data": {
    "MimosiGeDatabase": {
      "ConnectionString": "Enter_DatabaseConnectionString"
    }
  },

  "IdentitySettings": {
    "JwtSecret": "Enter_JwtSecret",
    "JwtIssuer": "Enter_JwtIssuer",
    "JwtAudience": "Enter_JwtAudience",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "FrontendBaseUrl": "Enter_FrontendBaseUrl"
  },

  "EmailSettings": {
    "SmtpServer": "Enter_SmtpServer",
    "SmtpPort": 587,
    "SmtpUsername": "Enter_SmtpUsername",
    "SmtpPassword": "Enter_SmtpPassword",
    "SenderEmailAddress": "noreply@mimosi.ge",
    "SenderName": "Enter_SenderName"
  },

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5070"
      }
    }
  },

  "Logging": {
    "File": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Console": {
      "IncludeScopes": true
    }
  },

  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Enter_PathToLogFile",
          "rollingInterval": "Day"
        }
      }
    ]
  },

  "TbcBis": {
    "BaseUrl": "Enter_BaseUrl",
    "ClientId": "Enter_ClientId",
    "ClientSecret": "Enter_ClientSecret",
    "AccountIban": "Enter_AccountIban",
    "BankAccountId": 4,
    "StartDate": "2026-11-08"
  },

  "BogBonline": {
    "TokenUrl": "https://account.bog.ge/auth/realms/bog/protocol/openid-connect/token",
    "ClientId": "Enter_ClientId",
    "ClientSecret": "Enter_ClientSecret",
    "BaseUrl": "Enter_BaseUrl",
    "AccountIban": "Enter_AccountIban",
    "BankAccountId": 1,
    "StartDate": "2026-11-08"
  },

  "CorsSettings": {
    "Origins": []
  },

  "VersionInfo": {
    "AppSettingsVersion": "1.1"
  }

}