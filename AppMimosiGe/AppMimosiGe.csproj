<Project Sdk="Microsoft.NET.Sdk.Web">
    <ItemGroup>
      <PackageReference Include="BackendCarcass.Api" />
      <PackageReference Include="Figgle.Fonts" />
      <PackageReference Include="WebSystemTools.CorsTools" />
      <PackageReference Include="WebSystemTools.MediatorTools" />
      <PackageReference Include="WebSystemTools.SerilogLogger" />
      <PackageReference Include="WebSystemTools.StaticFilesTools" />
      <PackageReference Include="WebSystemTools.SwaggerTools" />
      <PackageReference Include="WebSystemTools.TestToolsApi" />
      <PackageReference Include="WebSystemTools.ValidationTools" />
      <PackageReference Include="WebSystemTools.WindowsServiceTools" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\AppMimosiGe.Application\AppMimosiGe.Application.csproj" />
        <ProjectReference Include="..\AppMimosiGe.Infrastructure\AppMimosiGe.Infrastructure.csproj" />
        <ProjectReference Include="..\AppMimosiGe.WebApi\AppMimosiGe.WebApi.csproj" />
        <ProjectReference Include="..\AppMimosiGeRepositories\AppMimosiGeRepositories.csproj" />
        <ProjectReference Include="..\..\MimosiGeDbPart\MimosiGeDbPart.Db\MimosiGeDbPart.Db.csproj" />
        <ProjectReference Include="..\..\BackendCarcass\BackendCarcass.Application\BackendCarcass.Application.csproj" />
    </ItemGroup>
    <PropertyGroup>
        <UserSecretsId>245797f3-a8f3-4898-bd90-48b87927e5fc</UserSecretsId>
        <SpaRoot>..\..\AppMimosiGeFront\appmimosigefrontend\</SpaRoot>
    </PropertyGroup>
    <!-- publish-ის დროს React-ის ფრონტი იბილდება და მისი dist ფოლდერი პაკეტში wwwroot-ის სახით ხვდება -->
    <Target Name="PublishSpa" AfterTargets="ComputeFilesToPublish">
        <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
        <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
        <ItemGroup>
            <SpaDistFiles Include="$(SpaRoot)dist\**" />
            <ResolvedFileToPublish Include="@(SpaDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
                <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>
</Project>