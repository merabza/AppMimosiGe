<?xml version="1.0" encoding="utf-8"?>
<!-- დროებითი: ლოკალური ტესტირებისთვის BackendCarcass პაკეტები ლოკალური ფიდიდან იღება,
     სანამ SupportTools-ით ოფიციალურად გავრცელდება. გავრცელების შემდეგ ეს ფაილი წასაშლელია -->
<configuration>
  <packageSources>
    <add key="LocalFeed" value="D:\1WorkDotnet\LocalNugetFeed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="LocalFeed">
      <package pattern="BackendCarcass.*" />
      <package pattern="BackendCarcassShared.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
